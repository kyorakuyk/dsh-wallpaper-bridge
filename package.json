{
  "name": "dsh-wallpaper-bridge",
  "version": "0.1.4",
  "description": "Loopback DSH session bridge for the dsh-wallpaper desktop app.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyorakuyk/dsh-wallpaper-bridge.git"
  },
  "homepage": "https://github.com/kyorakuyk/dsh-wallpaper-bridge",
  "bugs": {
    "url": "https://github.com/kyorakuyk/dsh-wallpaper-bridge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "wallpaper",
    "bridge"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./protocol": "./lib/protocol.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5",
    "@types/node": "^22.0.0",
    "semver": "^6.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
